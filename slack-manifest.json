{
    "display_information": {
        "name": "N8N Slack Automation",
        "description": "N8N Slack Automation for Internal Marketing Sites",
        "background_color": "#2e2f30"
    },
    "features": {
        "bot_user": {
            "display_name": "Loft Demo Automation",
            "always_online": false
        }
    },
    "oauth_config": {
        "redirect_urls": [
            "http://localhost:5678/rest/oauth2-credential/callback"
        ],
        "scopes": {
            "user": [
                "chat:write"
            ],
            "bot": [
                "app_mentions:read",
                "chat:write",
                "chat:write.customize",
                "chat:write.public",
                "links:write"
            ]
        },
        "pkce_enabled": false
    },
    "settings": {
        "org_deploy_enabled": false,
        "socket_mode_enabled": false,
        "token_rotation_enabled": false,
        "is_mcp_enabled": false
    }
}